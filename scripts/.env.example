# Copy to .env, fill in, and NEVER commit the real file.
# In CI, set these as secrets instead of a checked-in .env.

# Cloudflare dashboard -> R2 -> Overview (account id is in the right sidebar)
R2_ACCOUNT_ID=

# R2 -> Manage API Tokens -> Create API Token (Object Read & Write, scoped to the bucket)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The bucket that holds releases/, stable.json, beta.json
R2_BUCKET=vura-releases

# Public URL the bucket is served from. Either:
#  - a custom domain attached to the bucket (recommended): https://storage.hale-software.com
#  - the R2.dev public bucket URL: https://<bucket-hash>.r2.dev
R2_PUBLIC_BASE_URL=https://storage.hale-software.com
